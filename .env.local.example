# ============================================
# Local Development Environment Variables Template
# ============================================
# 本地开发环境配置文件模板
# 使用方法: 复制此文件为 .env.local 并填入你的开发环境值
# .env.local 必须在 .gitignore 中（已配置），严禁提交
# ============================================

# Backend API URL (本地后端)
VITE_BACKEND_URL=http://localhost:8080

# Feature Flags for API Data Sources
# Set to "true" to use backend instead of Multicall
VITE_USE_API_POSITIONS=true
VITE_USE_API_ORDERS=true

# Feature Flag for API Order Submission
# When enabled, orders are submitted through backend API instead of directly to chain
VITE_USE_API_ORDER_SUBMIT=false

# App Configuration
VITE_APP_IS_HOME_SITE=false

# WalletConnect Configuration
# Get your project ID from: https://cloud.walletconnect.com/
VITE_WALLET_CONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Alchemy RPC Configuration
# Get your API key from: https://dashboard.alchemy.com/
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Proxy API (开发时可指向生产或 staging)
# 链由 VITE_DEFAULT_CHAIN 控制, 此处只需配单一后端 URL
VITE_PROXY_API_URL=https://api.primit.xyz
VITE_PROXY_WS_URL=wss://api.primit.xyz

# Smart Contract Addresses — replace 0x0000... with deployed addresses before running
VITE_ZTDX_VAULT_PROXY=0x0000000000000000000000000000000000000000
VITE_ZTDX_REBATE_PROXY=0x0000000000000000000000000000000000000000
VITE_ZTDX_EARN_PROXY=0x0000000000000000000000000000000000000000
VITE_ZTDX_USDT=0x0000000000000000000000000000000000000000

# Trading app origin
VITE_ZTDX_APP_ORIGIN=http://localhost:3012

# Default chain (numeric chain ID).
# Allowed values: 42161 (Arbitrum), 421614 (Arbitrum Sepolia), 43114 (Avalanche),
#                 43113 (Avalanche Fuji), 3637 (Botanix).
# Falls back to ARBITRUM_SEPOLIA (421614) when unset or invalid.
VITE_DEFAULT_CHAIN=421614
