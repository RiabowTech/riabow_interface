# ============================================
# Production Environment Variables Template
# ============================================
# 生产环境配置文件模板
# 使用方法: 复制此文件为 .env.production 并根据实际情况修改
# ============================================

# ============================================
# 应用基础配置
# ============================================

# 应用版本号 (通常由构建脚本自动设置，一般不需要手动配置)
# VITE_APP_VERSION=

# 是否为首页站点 (true/false)
# VITE_IS_HOME_SITE=false
# VITE_APP_IS_HOME_SITE=false
VITE_USE_API_POSITIONS=true
VITE_USE_API_ORDERS=true
VITE_USE_API_ORDER_SUBMIT=false
VITE_APP_IS_HOME_SITE=false

# ============================================
# 后端 API 配置
# ============================================

# 开发环境默认: http://localhost:8080
# 生产环境: https://api.primit.io
# 链由 VITE_DEFAULT_CHAIN 控制, 此处只需配单一后端 URL
VITE_PROXY_API_URL=https://api.primit.xyz
VITE_PROXY_WS_URL=wss://api.primit.xyz

# ============================================
# Sentry 错误监控配置
# ============================================

# Sentry DSN (Data Source Name)
# 用于上报页面崩溃和错误信息到 Sentry
# 格式: https://xxx@xxx.ingest.sentry.io/xxx
# VITE_SENTRY_DSN=

# ============================================
# WalletConnect 配置
# ============================================

# WalletConnect Project ID
# 从 https://cloud.walletconnect.com/ 获取您的 Project ID
# 必填: 用于启用钱包连接功能
VITE_WALLET_CONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ============================================
# RPC 节点配置
# ============================================

# Alchemy API Key
# 从 https://dashboard.alchemy.com/ 获取您的 API Key
# 必填: 用于访问 Alchemy RPC 节点服务
# 支持的链: Arbitrum, Avalanche, Base, BSC, Botanix, Optimism, Sepolia
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here

# 自定义 RPC URLs (可选)
# 如果配置了这些环境变量，将优先使用自定义的 RPC 而不是 Alchemy
# 格式: JSON 数组字符串，例如: ["https://rpc1.example.com","https://rpc2.example.com"]
# VITE_APP_ARBITRUM_RPC_URLS=
# VITE_APP_AVALANCHE_RPC_URLS=
# VITE_APP_BOTANIX_RPC_URLS=

# ============================================
# 主网 Arbitrum Primit 代理合约 (可选,不填则使用代码内默认值)
# ============================================
# VITE_PRIMIT_REBATE_PROXY=0x82D108Fd7b0746c6D3282c6132b1Ca55AD9E54ca
# VITE_PRIMIT_VAULT_PROXY=0x27671cf5864cEC3F4e409fc0e0f652B52fB834E8
# VITE_PRIMIT_EARN_PROXY=0xD006B6d0fff5f5c5fE9A17aCADe72b518205a288
# VITE_PRIMIT_USDT=0xFd086bC7CD5C481DCC9C85ebE478A1C0b69FCbb9

#Sepolia Proxy contracts
VITE_PRIMIT_REBATE_PROXY=0x630500A1f46e88f37F1979DB70fE8d768709cb93
VITE_PRIMIT_VAULT_PROXY=0x10BD9b5deaa4357048B95B24e5b3d3CfDAd6606A
VITE_PRIMIT_EARN_PROXY=0x63A141CDAf78db3Ca08a7D64bd215E86F780492b
VITE_PRIMIT_USDT=0xc96BDE5008518332Bb5c45177f9E70D75Ea5D865

# ============================================
# 默认链配置
# ============================================
# 数字 chainId, 控制应用默认链
# 可选值: 42161 (Arbitrum), 421614 (Arbitrum Sepolia), 43114 (Avalanche),
#         43113 (Avalanche Fuji), 3637 (Botanix)
# 未设置或非法值时回退到 ARBITRUM_SEPOLIA (421614)
VITE_DEFAULT_CHAIN=421614